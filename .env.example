# Copy to .env for local development. Names and placeholders only. Never commit real values.

# local | test | demo   (demo fails closed on unsafe transport/storage settings)
APP_ENV=local
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# Comma-separated browser origins allowed by CORS. Must be https:// and non-wildcard in demo mode.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Public URLs (required in demo mode, must be https://)
PUBLIC_WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001

# PostgreSQL. Required: the API refuses to start without it.
# In demo mode the URL must include sslmode=require or stricter.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/health_capital?schema=public

# Optional: separate database for integration tests. Falls back to DATABASE_URL when unset.
# DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/health_capital?schema=public

# Synthetic development password for every seeded account. Required by `pnpm db:seed`, which
# stores only its Argon2id hash: no plaintext password is ever written to the database.
# Choose your own value; at least 12 characters.
SEED_USER_PASSWORD=change-me-choose-a-local-synthetic-password

# Access-token signing secret. Required: the API refuses to start without it.
# Minimum 32 bytes; generate with: openssl rand -base64 48
JWT_SECRET=change-me-generate-a-real-secret-of-at-least-32-bytes

# Gemini (used from M4). Optional: when unset the platform runs with the NullProvider.
# GEMINI_API_KEY=change-me

# Maximum JSON request body in bytes
BODY_LIMIT_BYTES=65536

# Rate limiting. The global ceiling applies per client address across all routes; the login limit
# applies per client address and submitted address together.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_LOGIN_MAX=5
